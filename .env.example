# Copy to .env and fill in (never commit .env)
OPENROUTER_API_KEY=sk-or-v1-...

# Python environment holding Manim CE + ffmpeg (leave unset to use whatever
# `manim` is already on PATH)
# MANIM_ENV=/path/to/conda/envs/manim_env

# Optional OpenRouter TTS overrides (OpenRouter is the only TTS provider)
# MANIM_EXPLAIN_TTS_MODEL=x-ai/grok-voice-tts-1.0
# MANIM_EXPLAIN_TTS_VOICE=leo
# MANIM_EXPLAIN_STT_MODEL=openai/whisper-large-v3
